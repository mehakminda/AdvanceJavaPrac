      "updated": 1784698373471,
      "link": null,
      "locked": false,
      "text": "topic/partion are replicated indifferent brokers\n\nkafka broker 0 topic1 partition 1  -> leader\nkafka broker 1 topic1 partition 1  -> followers\nkafka broker 2 topic1 partition 1  -> followers\n\nProducers and cosumers will talk to leader not\nfollowers",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "topic/partion are replicated indifferent brokers\n\nkafka broker 0 topic1 partition 1  -> leader\nkafka broker 1 topic1 partition 1  -> followers\nkafka broker 2 topic1 partition 1  -> followers\n\nProducers and cosumers will talk to leader not followers",
      "autoResize": false,
      "lineHeight": 1.25
    },
