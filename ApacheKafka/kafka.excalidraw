      "updated": 1784698480558,
      "link": null,
      "locked": false,
      "text": "These\npartition\nare\nleaders ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "These partition are leaders ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "strJDrP8xxJ8UcdymlMtm",
      "type": "text",
      "x": -30.06755951204798,
      "y": 2247.364783627752,
      "width": 733.0996525066505,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 209817310,
      "version": 395,
      "versionNonce": 932440094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784698890618,
      "link": null,
      "locked": false,
      "text": "Maintains the metadata of the entire kafka cluster :\n\nhow many brokers are there. \nStatus of the brokers.\nhow many partition are there.\nwhich are the leader and followers partition.\nhow manny topics are there...\n\n<2.8 zookeeper > 2.8 kraft",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Maintains the metadata of the entire kafka cluster :\n\nhow many brokers are there. \nStatus of the brokers.\nhow many partition are there.\nwhich are the leader and followers partition.\nhow manny topics are there...\n\n<2.8 zookeeper > 2.8 kraft",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
